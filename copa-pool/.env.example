PORT=3000

# Gere um valor seguro: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=troque-por-valor-aleatorio-seguro

# Código secreto para acessar o painel admin
ADMIN_CODE=troque-por-codigo-secreto

# Restrinja ao domínio do deploy em produção (ex: https://meubolao.up.railway.app)
# Deixe * apenas para desenvolvimento local
CORS_ORIGIN=*
